FROM ghcr.io/ai-contained/ai-contained-base:latest

# TODO:  These are the dependencies of ai-contained-provider-aws-secrets and should be handled in ai-contained-finalize
RUN apk add aws-cli

# Credential providers go here. Tool providers live in ./Dockerfile.
# At runtime each provider reads from /secrets/<provider-name>/, which is
# bind-mounted from ${AI_CONTAINED_SECRETS_HOME} on the host (see docker-compose.yaml).
COPY --link --from=ghcr.io/ai-contained/ai-contained-provider-aws-secrets:latest / /

RUN ["/usr/local/bin/ai-contained-finalize"]

USER 65533:65533
